# App configuration template. Copy values you need to override into
# .env.local (gitignored, personal) rather than editing this file.
#
# VITE_API_BASE_URL
#   Purpose: absolute origin of the pwd-saver-be instance this build/run talks to.
#   Required: yes — the app fails to start/build if this is missing or not a valid URL.
#   Example:
VITE_API_BASE_URL=http://localhost:8080
