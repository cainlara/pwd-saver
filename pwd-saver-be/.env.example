# Copy this file to .env and fill in real values, then load it into your shell
# with: set -a && source .env && set +a
# .env is git-ignored; never commit real secrets.

# JDBC URL for the local Postgres instance (see docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/password_manager

# Postgres username (see docker-compose.yml)
DB_USERNAME=postgres

# Postgres password (see docker-compose.yml)
DB_PASSWORD=postgres

# Base64-encoded 256-bit AES key used to encrypt/decrypt vault passwords.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_WITH_A_REAL_BASE64_256BIT_KEY

# Spring Session JDBC idle timeout (optional — defaults to 30m if unset)
SESSION_TIMEOUT=30m

# HTTP port the service binds to (optional — defaults to 8080 if unset)
SERVER_PORT=8080

# Comma-separated list of browser origins (scheme://host[:port]) allowed to make
# cross-origin (CORS) requests to this API, e.g. https://app.example.com,http://localhost:5173
# Optional — if blank/unset, no cross-origin browser access is granted (deny-all default).
CORS_ALLOWED_ORIGINS=
