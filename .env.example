# Copy to .env and fill in real values: cp .env.example .env
# .env is git-ignored; never commit real secrets.
#
# Used by docker-compose.yml to configure the db/backend/frontend containers.

# --- Postgres (db service) ------------------------------------------------
POSTGRES_DB=password_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend (pwd-saver-be) ------------------------------------------------
# Base64-encoded 256-bit AES key used to encrypt/decrypt vault passwords.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_WITH_A_REAL_BASE64_256BIT_KEY

# Spring Session JDBC idle timeout (optional — defaults to 30m if unset)
SESSION_TIMEOUT=30m

# Origin the frontend is served from, allowed to make cross-origin
# credentialed requests to the backend. Defaults to
# http://localhost:${FRONTEND_PORT} if unset.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Frontend (pwd-saver-fe) ------------------------------------------------
# Absolute URL of the backend as reachable from the *browser* (not the
# docker-internal network name). Defaults to http://localhost:${BACKEND_PORT}.
VITE_API_BASE_URL=http://localhost:8080

# --- Host port mappings ----------------------------------------------------
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081
